# Local Docker Compose defaults. Copy to .env only when you need overrides.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
# Development-only password. Use a generated secret outside local development.
POSTGRES_PASSWORD=sentinel_dev_password
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000
DEMO_TARGET_PORT=8001

# This URL is compiled into the browser bundle and must be browser-reachable.
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TARGET_REQUEST_TIMEOUT_SECONDS=10

# Optional OpenAI semantic evaluator. Default/demo runs do not use it.
# Native backend: place these in backend/.env; Compose: use root .env.
JUDGE_ENABLED=false
OPENAI_API_KEY=
# Choose a Responses API model supporting structured outputs; prefer a snapshot.
JUDGE_MODEL=
JUDGE_TIMEOUT_SECONDS=20
# Optional operator-supplied USD estimates per million tokens. Blank means unknown.
JUDGE_INPUT_USD_PER_MILLION=
JUDGE_OUTPUT_USD_PER_MILLION=
JUDGE_PRICE_VERSION=unconfigured

# Local MVP only. Set token mode after migrations and operator-token provisioning.
# This gate does not provide tenant isolation or public-deployment readiness.
AUTH_MODE=local
APP_ENVIRONMENT=development
